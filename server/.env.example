# Server Environment Variables (Intervu)
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Google AI Configuration (Speech-to-text fallback)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Firebase Admin Credentials (path to JSON file or base64 encoded JSON string)
FIREBASE_SERVICE_ACCOUNT=path/to/service-account.json
# Or FIREBASE_PROJECT_ID if using ADC in Cloud Run
FIREBASE_PROJECT_ID=your_project_id

# AI Limits & Guards
AI_MONTHLY_LIMIT_PER_USER=50

# Reminders Threshold (in days)
REMINDER_INACTIVE_DAYS=3
